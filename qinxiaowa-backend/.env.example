# ============ 秦小娲的秦巴茶舍 · 后端环境变量示例 ============
# 复制为 .env 后按实际情况填写。.env 不要提交到 GitHub。

# ---- 基础 ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# 逗号分隔；比赛演示时填前端 H5 的访问域名
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 商品资料库 ----
# json = 读取 app/data/products.seed.json（默认，零依赖）
# sqlite = 读取 app/data/teahouse.db（先用 scripts/seed_sqlite.py 生成）
CATALOG_BACKEND=json
CATALOG_JSON_PATH=app/data/products.seed.json
CATALOG_SQLITE_PATH=app/data/teahouse.db

# ---- 安全外链（购买出口）----
# 只允许跳转到这些域名下的 https 链接，其余一律显示为“仅展示资料”
# 未接入真实店铺时保持为空即可，前端不会出现任何假下单入口
SHOP_LINK_ALLOWED_HOSTS=

# ---- 可选大模型（仅用于改写对白措辞，不生成商品事实）----
# 保持 LLM_ENABLED=false 时，全部对白走内置模板，功能完全可用
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=6
LLM_MAX_RETRIES=1

# ---- 会话（记录“当前商品”，用于换一款）----
SESSION_TTL_SECONDS=1800
